ANTHROPIC_API_KEY=your_key_here

# Full Access mode — set to true after running scripts/install-daemon-service.ps1
# When true: daemon runs as LocalSystem Windows Service, no admin prompts ever again
FULL_ACCESS=false
DEX_FULL_ACCESS=false

# ── Channels ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=

# ── Browser Agent ────────────────────────────────────────────────────────────
BROWSER_AGENT_PORT=8766
BROWSER_MODEL=claude-sonnet-4-6
# Leave false. A Tier 1 hand-off asks the owner to solve a CAPTCHA "in the open
# browser window" — with no window, that instruction is a lie and the task
# waits until it times out. Only set true for headless test runs.
BROWSER_HEADLESS=false

# ── Workspace (MCP) ──────────────────────────────────────────────────────────
# Which provider answers email/calendar/drive: google (default) or ms365
DEX_WORKSPACE_PROVIDER=
# Override if a server renames its entry point
DEX_GOOGLE_MCP_CMD=
DEX_GOOGLE_MCP_ARGS=
DEX_MS365_MCP_CMD=
DEX_MS365_MCP_ARGS=

# NOTE: Workspace credentials are deliberately NOT listed here.
# SAFETY.md: secrets live in the OS credential store, never in a file.
#   npm run cred -- list
#   npm run cred -- set google_oauth_client_id
#   npm run cred -- set google_oauth_client_secret
#   npm run cred -- set google_account_email
# They are decrypted at spawn time and handed only to the MCP child process.

DAEMON_PIPE_NAME=\.\pipe\dex_privileged_daemon
