# --- vendored engine runtimes (NOT in the repo) ---
# The repo is just the Dex agent (dex/) + the Flutter app (app/). The
# heavy Python engines (UFO² ~1.7G, browser-use ~429M) are NOT vendored:
# `dex engines setup` clones/pip-installs them into ~/.dex/engines, and
# the MSI bundles prebuilt venvs from a build machine. vendor/ may still
# exist locally as a working setup, but it never enters the repo.
/vendor/

# --- secrets & user-pasted keys (never commit) ---
vendor/UFO/config/ufo/agents.yaml
# Phase B.9 restructure: vendor/openclaw/ moved to dex/core/. Keep the old
# pattern as defense-in-depth in case an upstream sync re-vendors briefly.
vendor/openclaw/.env
vendor/openclaw/.env.*
dex/core/.env
dex/core/.env.*
**/.env
**/.env.*
**/api_keys.json
**/*.key
*.pem
.secrets/

# --- python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
# (removed bare `env/` rule -- it was catching source dirs like
#  core/src/env/. Python venv users should use .venv/ or venv/.)
*.egg-info/

# --- node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
# Phase B.9: dex/core build outputs. core/.gitignore already excludes
# these inside the workspace, but list them here so a top-level pnpm /
# corrupted install never leaks dist artifacts into git.
dex/core/dist/
dex/core/.turbo/
dex/core/coverage/
dex/core/.cache/
dex/core/.vite/
dex/core/.vite-temp/
dex/core/.next/
# Rebrand idempotency sentinel + migration-script scratch.
dex/.dex-rebranded
docs/migration/.scratch/

# --- flutter / dart ---
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/build/
app/.pub/
app/pubspec.lock
app/windows/flutter/ephemeral/
app/windows/CMakeFiles/
app/windows/*.vcxproj.user

# --- OS / IDE ---
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# --- logs / scratch ---
*.log
logs/
scratch/
.notes-scratch/

# Claude Code per-user permission allowlist. Often contains transient
# API keys via Bash(curl ...) entries -- never commit.
.claude/settings.local.json

# Scratch drops at project root -- screenshots / reference photos /
# scratch text. Lives only locally; never commit.
/image*.png
/future.png
/dex_ascii.txt
/Dex — Implementation Plan.txt
/copilot-ref/
/image-tobedeleted.png

# graphify knowledge-graph output (large, regenerable dev artifact, never shipped)
graphify-out/
**/graphify-out/

# Codex scratch
.codex/

# --- installer build outputs ---
installer/payload/
installer/*.msi
installer/*.wixpdb
installer/*.wixobj
installer/*.wixlib
installer/payload.wxs
