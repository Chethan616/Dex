node_modules/
dist/
*.tsbuildinfo

# Secrets — never commit. Runtime secrets belong in the OS credential store
# (core/secrets/credential_store.ts), not in any file here.
.env
.env.*
!.env.example
*.dpapi
*.pem
*.key
*.p12
*.pfx
credentials.json
token.json
client_secret*.json

# Runtime data — evidence contains screenshots of the owner's screen
data/evidence/
data/sessions/
data/cache/
data/telemetry.db
data/*.db
# SQLite WAL sidecars — same content as the database, and "data/*.db"
# does not match them. They hold the owner's task history.
data/*.db-shm
data/*.db-wal
data/*.db-journal
*.log

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# Flutter
ui/dex-bar/build/
ui/dex-bar/.dart_tool/
ui/dex-bar/windows/flutter/ephemeral/
.flutter-plugins-dependencies
.dart_tool/

# Local scratch
scratchpad/
scratch_*
*.local

# Local analysis and hardware reports — never part of a source push
graphify-out/
battery-report.html
@AutomationLog.txt
image[0-9]*.png

# OS
Thumbs.db
.DS_Store
desktop.ini

# The v1 tree, kept locally for reference. It is a fork of another project and
# has no bearing on this one — nothing here imports from it.
Dex-main/

# Personal documents that happen to live in the working folder.
*.docx
image*.png

# Flutter build output.
app/build/
app/.dart_tool/
ui/dex-bar/build/
ui/dex-bar/.dart_tool/
