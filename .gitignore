# --- secrets & user-pasted keys (never commit) ---
vendor/UFO/config/ufo/agents.yaml
# Phase B.9 restructure: vendor/openclaw/ moved to dex/core/. Keep the old
# pattern as defense-in-depth in case an upstream sync re-vendors briefly.
vendor/openclaw/.env
vendor/openclaw/.env.*
dex/core/.env
dex/core/.env.*
**/.env
**/.env.*
**/api_keys.json
**/*.key
*.pem
.secrets/

# --- python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
# (removed bare `env/` rule -- it was catching source dirs like
#  core/src/env/. Python venv users should use .venv/ or venv/.)
*.egg-info/

# --- node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
# Phase B.9: dex/core build outputs. core/.gitignore already excludes
# these inside the workspace, but list them here so a top-level pnpm /
# corrupted install never leaks dist artifacts into git.
dex/core/dist/
dex/core/.turbo/
dex/core/coverage/
dex/core/.cache/
dex/core/.vite/
dex/core/.vite-temp/
dex/core/.next/
# Rebrand idempotency sentinel + migration-script scratch.
dex/.dex-rebranded
docs/migration/.scratch/

# --- flutter / dart ---
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/build/
app/.pub/
app/pubspec.lock
app/windows/flutter/ephemeral/
app/windows/CMakeFiles/
app/windows/*.vcxproj.user

# --- OS / IDE ---
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# --- logs / scratch ---
*.log
logs/
scratch/
.notes-scratch/
