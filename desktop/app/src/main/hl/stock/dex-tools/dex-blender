#!/usr/bin/env bash
# dex-blender — Blender for 3D work. It runs in the BACKGROUND: no window, the
# user keeps their desktop. Never open the Blender app unless they ask.
#
#   dex-blender status                      this task's background Blender (the Blender tools' scene)
#   dex-blender scene                       path of that scene — autosaved after every change
#   dex-blender run script.py [file.blend]  run a Python script in a separate headless Blender
#   dex-blender render file.blend out.png [--engine eevee|cycles] [--samples N] [--size WxH]
#                                           render a still headless (Cycles uses the GPU)
#   dex-blender show [file.blend]           ONLY when the user asks to see it: open a copy of the
#                                           scene (or the file) in the Blender app on their screen
#
# The Blender tools (mcp__blender__* / dex_blender) start this task's background
# Blender by themselves on first use — there is nothing to open first.

set -uo pipefail

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
[ $# -ge 1 ] || usage
case "$1" in -h|--help|help) usage ;; esac

exe="${DEX_BLENDER:-}"
if [ -z "$exe" ] || [ ! -f "$exe" ]; then
  exe="$(ls -d "/c/Program Files/Blender Foundation"/Blender*/blender.exe 2>/dev/null | sort -V | tail -1)"
fi
[ -n "$exe" ] && [ -f "$exe" ] || { echo "dex-blender: Blender isn't installed (winget install BlenderFoundation.Blender)." >&2; exit 3; }

winpath() { command -v cygpath >/dev/null 2>&1 && cygpath -w "$1" || printf '%s' "$1"; }
unixpath() { command -v cygpath >/dev/null 2>&1 && cygpath -u "$1" || printf '%s' "$1"; }
# Relative paths mean relative to *this* shell — Blender resolves them against its own cwd.
abspath() { case "$1" in /*|[A-Za-z]:[\/]*|"") printf '%s' "$1" ;; *) printf '%s/%s' "$PWD" "$1" ;; esac; }

# This task's background Blender keeps its scene here (same rule as mcp-servers/blender).
home="${DEX_BLENDER_HOME:-}"
[ -n "$home" ] || home="$(dirname "$(unixpath "${DEX_CONTROL_FILE:-${APPDATA:-$HOME}/DEX/x}")")/blender"
home="$(unixpath "$home")"
task="$(printf '%s' "${DEX_SESSION_ID:-shared}" | tr -c 'A-Za-z0-9_-' '_')"
taskdir="$home/$task"
scene="$taskdir/scene.blend"
listening() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
hostport() { sed -n 's/.*"port":[[:space:]]*\([0-9]*\).*//p' "$taskdir/host.json" 2>/dev/null; }

op="$1"; shift
case "$op" in
  status)
    port="$(hostport)"
    if [ -n "$port" ] && listening "$port"; then
      echo "This task's Blender is running in the background (no window, port $port) — the Blender tools work on it."
    else
      echo "This task's Blender isn't running right now — the first Blender tool call starts it in the background (a few seconds)."
    fi
    if [ -f "$scene" ]; then echo "Scene (autosaved after every change): $(winpath "$scene")"
    else echo "No scene saved yet for this task."; fi ;;

  scene)
    winpath "$scene"
    [ -f "$scene" ] || { echo "dex-blender: nothing saved yet — build something with the Blender tools first." >&2; exit 1; } ;;

  show|open)
    # For the user's eyes only. A copy, so their clicking around can't fight the
    # background Blender's autosave.
    file="$(abspath "${1:-}")"
    if [ -z "$file" ]; then
      [ -f "$scene" ] || { echo "dex-blender: nothing to show yet — this task has no scene." >&2; exit 1; }
      file="$taskdir/scene-view.blend"
      cp -f "$scene" "$file"
    fi
    [ -f "$file" ] || { echo "dex-blender: no such file: $file" >&2; exit 2; }
    if command -v cmd.exe >/dev/null 2>&1; then cmd.exe //c start "" "$(winpath "$exe")" "$(winpath "$file")" >/dev/null 2>&1
    else ( "$exe" "$file" >/dev/null 2>&1 & ); fi
    echo "Opened $(winpath "$file") in Blender on the user's screen. Keep working through the Blender tools — they use the background scene, not this window." ;;

  run)
    [ $# -ge 1 ] || usage
    script="$(abspath "$1")"; blend="$(abspath "${2:-}")"
    [ -f "$script" ] || { echo "dex-blender: no such script: $script" >&2; exit 2; }
    "$exe" -b ${blend:+"$(winpath "$blend")"} --python-exit-code 1 -P "$(winpath "$script")" 2>&1 | grep -v "^Blender quit$\|CUEW initialization failed"
    exit "${PIPESTATUS[0]}" ;;

  render)
    [ $# -ge 2 ] || usage
    blend="$(abspath "$1")"; out="$(abspath "$2")"; shift 2
    engine=eevee; samples=""; size=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --engine) engine="$2"; shift ;;
        --samples) samples="$2"; shift ;;
        --size) size="$2"; shift ;;
        *) echo "dex-blender render: unknown option $1" >&2; exit 2 ;;
      esac
      shift
    done
    [ -f "$blend" ] || { echo "dex-blender: no such file: $blend" >&2; exit 2; }
    py=$(cat <<PY
import bpy, os
s = bpy.context.scene
eng = "$engine".lower()
if eng == "cycles":
    s.render.engine = "CYCLES"
    try:
        p = bpy.context.preferences.addons["cycles"].preferences
        for kind in ("OPTIX", "CUDA", "HIP", "ONEAPI", "METAL"):
            try:
                p.compute_device_type = kind
            except TypeError:
                continue
            p.refresh_devices()
            gpus = [d for d in p.devices if d.type == kind]
            if gpus:
                for d in p.devices: d.use = d.type == kind
                s.cycles.device = "GPU"
                print("DEX: Cycles on", kind, [d.name for d in gpus])
                break
    except Exception as e:
        print("DEX: GPU unavailable, using CPU:", e)
    if "$samples": s.cycles.samples = int("$samples")
else:
    for ident in ("BLENDER_EEVEE_NEXT", "BLENDER_EEVEE"):
        try:
            s.render.engine = ident; break
        except TypeError:
            continue
    if "$samples":
        try: s.eevee.taa_render_samples = int("$samples")
        except Exception: pass
if "$size":
    w, h = "$size".lower().split("x"); s.render.resolution_x, s.render.resolution_y = int(w), int(h)
    s.render.resolution_percentage = 100
if s.camera is None:
    raise SystemExit("DEX: the scene has no camera — add one and aim it first")
s.render.filepath = r"$(winpath "$out")"
bpy.ops.render.render(write_still=True)
print("DEX: rendered", s.render.filepath, s.render.engine, f"{s.render.resolution_x}x{s.render.resolution_y}")
PY
)
    "$exe" -b "$(winpath "$blend")" --python-exit-code 1 --python-expr "$py" 2>&1 | grep -E "^DEX:|Error|error|Traceback|Saved:" | grep -v CUEW
    rc="${PIPESTATUS[0]}"
    # Record the render so it shows in the task — and on the phone — with a preview.
    if [ "$rc" = 0 ] && [ -f "$out" ] && [ -n "${DEX_SESSION_ID:-}" ] && command -v dex-state >/dev/null 2>&1; then
      dex-state file "$out" >/dev/null 2>&1 || true
    fi
    exit "$rc" ;;

  *) echo "dex-blender: unknown command '$op'" >&2; usage ;;
esac
