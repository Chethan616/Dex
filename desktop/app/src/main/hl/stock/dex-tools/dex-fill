#!/usr/bin/env bash
# dex-fill — put a stored credential into a browser login field.
#
#   dex-fill <host> user "#username"      (best: pass the field's CSS selector)
#   dex-fill <host> pass "#password"
#
# The selector is optional but recommended: with it, DEX finds and fills that
# exact field. Without it, DEX fills whatever input is currently focused, so
# click the field first.
#
# The value goes straight from the credential store into the page. It is never
# returned to you and never appears in the transcript — you place the field,
# DEX enters the secret. If nothing is stored, it says so.

set -uo pipefail
. "$(dirname "$0")/dex-lib.sh"

[ $# -ge 2 ] || { echo "usage: dex-fill <host> user|pass [css-selector]" >&2; exit 2; }
target="$1"; kind="$2"; selector="${3:-}"
case "$kind" in
  user|username) field="username" ;;
  pass|password) field="password" ;;
  *) echo "dex-fill: second argument must be 'user' or 'pass'" >&2; exit 2 ;;
esac

session="$(dex_session_id)"
[ -n "$session" ] || { echo "dex-fill: no session id in the environment" >&2; exit 3; }

body="{\"sessionId\":\"$(dex_esc "$session")\",\"target\":\"$(dex_esc "$target")\",\"field\":\"${field}\""
[ -n "$selector" ] && body="${body},\"selector\":\"$(dex_esc "$selector")\""
body="${body}}"

dex_post /dex/fill "$body"
