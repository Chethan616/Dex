#!/usr/bin/env bash
# dex-registry — read the Windows registry freely; set, delete and import
# always back up first and wait for the user to approve the exact change
# in the app before anything is written.
#
#   dex-registry read <path>
#   dex-registry get <path> <name>
#   dex-registry search <root> <query> [max-results]
#   dex-registry export <path> <file>
#   dex-registry set <path> <name> <value> [type]      -- gated
#   dex-registry delete <path> [name]                  -- gated
#   dex-registry import <file>                         -- gated
#
# <path> is a hive-qualified path: HKCU\Software\Foo, HKLM\..., etc.
# <type> for set is one of String (default), ExpandString, DWord, QWord,
# Binary (comma-separated bytes), MultiString (semicolon-separated).
#
# The read-only verbs (read/get/search/export) never touch main — they call
# PowerShell directly, the same as dex-uia. Only a real write goes through
# the /dex/confirm round trip: this backs the affected key up, builds a
# plain-text description of exactly what is about to change, and blocks on
# a human answer before calling PowerShell again to actually apply it.

set -uo pipefail
. "$(dirname "$0")/dex-lib.sh"
DIR="$(cd "$(dirname "$0")" && pwd)"
PS1="$DIR/dex-registry.ps1"

usage() {
  cat >&2 <<'USAGE'
usage:
  dex-registry read <path>
  dex-registry get <path> <name>
  dex-registry search <root> <query> [max-results]
  dex-registry export <path> <file>
  dex-registry set <path> <name> <value> [type]
  dex-registry delete <path> [name]
  dex-registry import <file>
USAGE
  exit 2
}

run_ps() {
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$PS1" "$@"
}

# Blocks until the user answers in the app, or the confirmation times out
# (main treats a timeout as a denial). Prints "true"/"false" on stdout.
ask_confirmation() {
  local title="$1" detail="$2" session response
  session="$(dex_session_id)"
  [ -n "$session" ] || { echo "dex-registry: no session id in the environment (DEX_SESSION_ID)" >&2; return 2; }
  response="$(dex_post /dex/confirm "{\"sessionId\":\"$(dex_esc "$session")\",\"title\":\"$(dex_esc "$title")\",\"detail\":\"$(dex_esc "$detail")\"}")" || return 1
  case "$response" in
    *'"approved":true'*) echo "true" ;;
    *) echo "false" ;;
  esac
}

backup_dir="${DEX_REGISTRY_BACKUPS_DIR:-${TEMP:-/tmp}/dex-registry-backups}"
mkdir -p "$backup_dir" 2>/dev/null || true

[ $# -ge 1 ] || usage
op="$1"; shift

case "$op" in
  read)
    [ $# -ge 1 ] || { echo "usage: dex-registry read <path>" >&2; exit 2; }
    run_ps -Op read -Path "$1"
    ;;

  get)
    [ $# -ge 2 ] || { echo "usage: dex-registry get <path> <name>" >&2; exit 2; }
    run_ps -Op get -Path "$1" -Name "$2"
    ;;

  search)
    [ $# -ge 2 ] || { echo "usage: dex-registry search <root> <query> [max-results]" >&2; exit 2; }
    run_ps -Op search -Path "$1" -Query "$2" -MaxResults "${3:-50}"
    ;;

  export)
    [ $# -ge 2 ] || { echo "usage: dex-registry export <path> <file>" >&2; exit 2; }
    run_ps -Op export -Path "$1" -File "$2"
    ;;

  set)
    [ $# -ge 3 ] || { echo "usage: dex-registry set <path> <name> <value> [type]" >&2; exit 2; }
    path="$1"; name="$2"; value="$3"; type="${4:-String}"

    current="$(run_ps -Op get -Path "$path" -Name "$name" 2>/dev/null)"
    backup_file="$backup_dir/$(date +%Y%m%d-%H%M%S)-set.reg"
    run_ps -Op export -Path "$path" -File "$backup_file" >/dev/null 2>&1 || true

    title="Set registry value"
    detail="Path: ${path}
Name: ${name}
Type: ${type}
New value: ${value}
Current: ${current}
Backup: ${backup_file}"

    approved="$(ask_confirmation "$title" "$detail")" || exit 1
    if [ "$approved" != "true" ]; then
      echo '{"ok":false,"error":"the user denied this registry change"}'
      exit 1
    fi
    run_ps -Op set -Path "$path" -Name "$name" -Value "$value" -Type "$type"
    ;;

  delete)
    [ $# -ge 1 ] || { echo "usage: dex-registry delete <path> [name]" >&2; exit 2; }
    path="$1"; name="${2:-}"

    current="$(run_ps -Op read -Path "$path" 2>/dev/null)"
    backup_file="$backup_dir/$(date +%Y%m%d-%H%M%S)-delete.reg"
    run_ps -Op export -Path "$path" -File "$backup_file" >/dev/null 2>&1 || true

    if [ -n "$name" ]; then
      title="Delete registry value"
      detail="Path: ${path}
Name: ${name}
Current state: ${current}
Backup: ${backup_file}"
    else
      title="Delete registry key"
      detail="Path: ${path}
This deletes the entire key, all its values, and all its subkeys.
Current state: ${current}
Backup: ${backup_file}"
    fi

    approved="$(ask_confirmation "$title" "$detail")" || exit 1
    if [ "$approved" != "true" ]; then
      echo '{"ok":false,"error":"the user denied this registry change"}'
      exit 1
    fi
    if [ -n "$name" ]; then
      run_ps -Op delete -Path "$path" -Name "$name"
    else
      run_ps -Op delete -Path "$path"
    fi
    ;;

  import)
    [ $# -ge 1 ] || { echo "usage: dex-registry import <file>" >&2; exit 2; }
    file="$1"

    title="Import registry file"
    detail="File: ${file}
No automatic backup is taken for import — a .reg file can touch several
keys at once, and which ones aren't known without parsing it. If you want
to be able to undo this, export the specific keys you expect it to affect
with 'dex-registry export' first."

    approved="$(ask_confirmation "$title" "$detail")" || exit 1
    if [ "$approved" != "true" ]; then
      echo '{"ok":false,"error":"the user denied this registry change"}'
      exit 1
    fi
    run_ps -Op import -File "$file"
    ;;

  -h|--help|help) usage ;;
  *) echo "dex-registry: unknown verb '$op'" >&2; usage ;;
esac
