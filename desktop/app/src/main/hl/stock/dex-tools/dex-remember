#!/usr/bin/env bash
# dex-remember — teach DEX something the user told it: a fact about them, a site
# they named, or a login they gave.
#
# The user says it once ("I work night shifts", "my bank's site is
# netbanking.example.com", or hands you a username and password); you record it here so
# later sessions — on any engine, in any chat — act on it without asking again.
# Passwords are stored in the OS credential store and are never printed back by
# any tool.
#
# See site-memory.md for when to call this.

set -uo pipefail
. "$(dirname "$0")/dex-lib.sh"

usage() {
  cat >&2 <<'USAGE'
usage:
  dex-remember note "<one fact>" [--replaces <id>] [--topic <t>]   e.g. dex-remember note "Prefers aisle seats on flights"
      topics (optional, guessed from the words otherwise): about home study work prefs writing food
      travel money health people tech fun routines other
  dex-remember forget-note <id-or-words>             drop a note the user wants forgotten
  dex-remember list                                  everything DEX remembers (notes, sites; never a password)
  dex-remember site <url-or-host> <nickname>...     e.g. dex-remember site portal.example.edu "college portal" "uni portal"
  dex-remember login <url-or-host> [--user <u>] [--pass <p>]
  dex-remember forget <url-or-host>                  drop a site and its stored login

  A note is one short fact about the user, kept for every later task on any
  engine — never a password, key or card number (those are refused).

  Record a login only when the user has given you the details for their own
  account. Never invent them, and never ask them to paste a password to you if
  a browser login field is available — fill it with dex-fill instead.
USAGE
  exit 2
}

[ "${1:-}" = "list" ] && { dex_post /dex/memory '{}'; exit $?; }
[ $# -ge 2 ] || usage
op="$1"; shift

case "$op" in
  note)
    text="$1"; shift
    replaces=""; topic=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --replaces) replaces="${2:-}"; shift 2 ;;
        --topic) topic="${2:-}"; shift 2 ;;
        *) text="${text} $1"; shift ;;
      esac
    done
    body="{\"text\":\"$(dex_esc "$text")\""
    [ -n "$replaces" ] && body="${body},\"replaces\":\"$(dex_esc "$replaces")\""
    [ -n "$topic" ] && body="${body},\"topic\":\"$(dex_esc "$topic")\""
    dex_post /dex/remember-note "${body}}"
    ;;
  forget-note)
    dex_post /dex/forget-note "{\"ref\":\"$(dex_esc "$*")\"}"
    ;;
  site)
    target="$1"; shift
    [ $# -ge 1 ] || { echo "dex-remember site: give at least one nickname" >&2; exit 2; }
    aliases=""
    for a in "$@"; do
      [ -n "$aliases" ] && aliases="${aliases},"
      aliases="${aliases}\"$(dex_esc "$a")\""
    done
    dex_post /dex/remember-site "{\"target\":\"$(dex_esc "$target")\",\"aliases\":[${aliases}]}"
    ;;
  login)
    target="$1"; shift
    user=""; pass=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --user) user="${2:-}"; shift 2 ;;
        --pass) pass="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    body="{\"target\":\"$(dex_esc "$target")\""
    [ -n "$user" ] && body="${body},\"username\":\"$(dex_esc "$user")\""
    [ -n "$pass" ] && body="${body},\"password\":\"$(dex_esc "$pass")\""
    body="${body}}"
    dex_post /dex/remember-login "$body"
    ;;
  forget)
    target="$1"
    dex_post /dex/forget-site "{\"target\":\"$(dex_esc "$target")\"}"
    ;;
  -h|--help|help) usage ;;
  *) echo "dex-remember: unknown verb '$op'" >&2; usage ;;
esac
