#!/usr/bin/env bash
# dex-sh — run a command through a specific shell, with a timeout, and get
# back consistent JSON: exit code, stdout, stderr — the same shape regardless
# of which shell ran it. Useful when one shell fails for an
# environment-specific reason (PATH, quoting, a missing tool) and you want to
# retry through another without losing the exact exit code and stderr you'd
# need to tell the two failures apart.
#
#   dex-sh <bash|cmd|powershell|wsl> "<command>" [timeout-seconds]
#
# Gated by the session's approval policy (src/main/approvals/policy.ts),
# not by dex-sh itself — Grid view's autonomous agents default to 'full'
# access, the same ungated behavior this tool has always had, so this adds
# no visible ceremony there. A LiveBrowser session set to "Ask for
# approval" (or "Approve for me" on a command the risk heuristic flags)
# gets a real confirmation card first, the same plumbing dex-registry uses.

set -uo pipefail
. "$(dirname "$0")/dex-lib.sh"

usage() {
  echo 'usage: dex-sh <bash|cmd|powershell|wsl> "<command>" [timeout-seconds]' >&2
  exit 2
}

[ $# -ge 2 ] || usage
shell="$1"
cmd="$2"
timeout_s="${3:-30}"

session="$(dex_session_id)"
if [ -n "$session" ]; then
  confirm_body="{\"sessionId\":\"$(dex_esc "$session")\",\"title\":\"Run a shell command\",\"detail\":\"$(dex_esc "$shell: $cmd")\",\"category\":\"process-launch\",\"subject\":\"$(dex_esc "$cmd")\"}"
  confirm_response="$(dex_post /dex/confirm "$confirm_body")"
  confirm_status=$?
  approved="$(printf '%s' "$confirm_response" | sed -n 's/.*"approved"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p')"
  # A non-2xx from dex_post (server unreachable, control file missing) is
  # treated the same as an explicit denial — silently running an unapproved
  # command because the approval channel itself broke would defeat the
  # point of gating it at all.
  if [ "$confirm_status" -ne 0 ] || [ "$approved" != "true" ]; then
    printf '{"exitCode":126,"timedOut":false,"stdout":"","stderr":"command not approved"}\n'
    exit 126
  fi
fi

err_file="$(mktemp)"
trap 'rm -f "$err_file"' EXIT

case "$shell" in
  bash)
    out="$(timeout "$timeout_s" bash -c "$cmd" 2>"$err_file")"
    code=$?
    ;;
  cmd)
    # Double-slash flags: Git Bash's MSYS layer auto-converts a leading
    # "/c" into a Windows path (it looks like a one-letter POSIX path) when
    # handing arguments to a native .exe, which silently turned this into
    # plain `cmd.exe` with no command at all — confirmed live, it printed
    # cmd's own startup banner instead of running anything. "//c" survives
    # MSYS's conversion untouched and cmd.exe still accepts it.
    out="$(timeout "$timeout_s" cmd.exe //d //c "$cmd" 2>"$err_file")"
    code=$?
    ;;
  powershell)
    out="$(timeout "$timeout_s" powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$cmd" 2>"$err_file")"
    code=$?
    ;;
  wsl)
    out="$(timeout "$timeout_s" wsl.exe bash -c "$cmd" 2>"$err_file")"
    code=$?
    ;;
  *)
    echo "dex-sh: unknown shell '$shell' — use bash, cmd, powershell or wsl" >&2
    usage
    ;;
esac

# 124 is coreutils timeout's own "the command was killed for running too
# long" code — distinct from anything the command itself could return, so a
# caller can tell "timed out" apart from "ran and failed" without parsing text.
timed_out="false"
[ "$code" -eq 124 ] && timed_out="true"

err="$(cat "$err_file" 2>/dev/null)"

printf '{"exitCode":%d,"timedOut":%s,"stdout":"%s","stderr":"%s"}\n' \
  "$code" "$timed_out" "$(dex_esc "$out")" "$(dex_esc "$err")"
