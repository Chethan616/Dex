#!/usr/bin/env bash
# dex-websearch — a plain factual web lookup, no browser tab needed.
#
#   dex-websearch "current Node.js LTS version"
#   dex-websearch "capital of Australia" --limit 5
#
# For a question that just needs an answer from the open web — not a
# specific site's own UI, not something behind a login. See websearch.md
# for when this beats driving a browser.

set -uo pipefail
. "$(dirname "$0")/dex-lib.sh"

[ $# -ge 1 ] || { echo "usage: dex-websearch <query> [--limit N]" >&2; exit 2; }

limit=""
query=""
while [ $# -gt 0 ]; do
  case "$1" in
    --limit)  limit="${2:-}"; shift 2 ;;
    *)        query="${query:+$query }$1"; shift ;;
  esac
done

[ -n "$query" ] || { echo "dex-websearch: a query is required" >&2; exit 2; }

session="$(dex_session_id)"
[ -n "$session" ] || { echo "dex-websearch: no session id in the environment (DEX_SESSION_ID)" >&2; exit 3; }

body="{\"sessionId\":\"$(dex_esc "$session")\",\"query\":\"$(dex_esc "$query")\""
[ -n "$limit" ] && body="${body},\"limit\":${limit}"
body="${body}}"

dex_post /dex/websearch "$body"
