{
    "manifest_version":  3,
    "name":  "Dex",
    "version":  "1.0.4",
    "description":  "Lets Dex act in the browser you are already signed into.",
    "icons":  {
                  "16":  "icons/icon-16.png",
                  "32":  "icons/icon-32.png",
                  "48":  "icons/icon-48.png",
                  "128":  "icons/icon-128.png"
              },
    "permissions":  [
                        "alarms",
                        "activeTab",
                        "debugger",
                        "bookmarks",
                        "history",
                        "scripting",
                        "sidePanel",
                        "storage",
                        "tabs"
                    ],
    "host_permissions":  [
                             "\u003call_urls\u003e"
                         ],
    "background":  {
                       "service_worker":  "src/background/background.js",
                       "type":  "module"
                   },
    "action":  {
                   "default_title":  "Dex Ã¢â‚¬â€ open the chat panel"
               },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "\u003call_urls\u003e"
                                            ],
                                "js":  [
                                           "src/polyfill/browser-polyfill.min.js",
                                           "src/content/content.js"
                                       ],
                                "run_at":  "document_idle"
                            }
                        ],
    "web_accessible_resources":  [
                                     {
                                         "resources":  [
                                                           "src/polyfill/browser-polyfill.min.js"
                                                       ],
                                         "matches":  [
                                                         "\u003call_urls\u003e"
                                                     ]
                                     }
                                 ],
    "side_panel":  {
                       "default_path":  "src/panel/panel.html"
                   }
}