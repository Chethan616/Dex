{
  "name": "dex-mesh-relay",
  "version": "0.1.0",
  "private": true,
  "description": "A dumb WebSocket switchboard for Dex Mesh. Pairs two sockets by room id and copies bytes. Stores nothing, decrypts nothing.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
