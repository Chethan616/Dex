{
  "name": "dexv3",
  "version": "0.1.0",
  "description": "DEX V3 — Personal AI automation system for Windows",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "ts-node src/main.ts",
    "build": "tsc",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "test:ws": "ts-node tests/smoke_ws.ts",
    "cred": "ts-node scripts/dex-cred.ts",
    "test:slice4": "ts-node tests/smoke_slice4.ts",
    "test:slice45": "ts-node tests/smoke_slice45.ts",
    "test:e2e": "ts-node tests/e2e_tier2.ts",
    "test:workflows": "ts-node tests/smoke_workflows.ts",
    "test:channels": "ts-node tests/smoke_channels.ts",
    "test:memory": "ts-node tests/smoke_memory.ts",
    "test:e2e-memory": "ts-node tests/e2e_memory.ts",
    "test:boot": "ts-node tests/smoke_boot.ts",
    "conformance": "ts-node tests/conformance/run.ts",
    "test:daemon": "python tests/test_daemon_proc.py",
    "test:scripts": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/check_scripts.ps1",
    "test:uia": "python tests/test_uia_matching.py",
    "test:files": "ts-node tests/smoke_files.ts",
    "test:full-access": "ts-node tests/smoke_full_access.ts",
    "test:scheduler": "ts-node tests/smoke_scheduler.ts",
    "test:settings": "ts-node tests/smoke_settings.ts",
    "test:no-console": "python tests/test_no_console.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.45.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
