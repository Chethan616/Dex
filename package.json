{
  "name": "dexv3",
  "version": "0.1.0",
  "description": "DEX V3 \u2014 Personal AI automation system for Windows",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "ts-node src/main.ts",
    "build": "tsc",
    "rebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rebuild.ps1",
    "rebuild:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rebuild.ps1 -Fast",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "test:ws": "ts-node tests/smoke_ws.ts",
    "cred": "ts-node scripts/dex-cred.ts",
    "test:slice4": "ts-node tests/smoke_slice4.ts",
    "test:slice45": "ts-node tests/smoke_slice45.ts",
    "test:e2e": "ts-node tests/e2e_tier2.ts",
    "test:workflows": "ts-node tests/smoke_workflows.ts",
    "test:channels": "ts-node tests/smoke_channels.ts",
    "test:memory": "ts-node tests/smoke_memory.ts",
    "test:e2e-memory": "ts-node tests/e2e_memory.ts",
    "test:boot": "ts-node tests/smoke_boot.ts",
    "conformance": "ts-node tests/conformance/run.ts",
    "test:daemon": "python tests/test_daemon_proc.py",
    "test:scripts": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/check_scripts.ps1",
    "test:uia": "python tests/test_uia_matching.py",
    "test:files": "ts-node tests/smoke_files.ts",
    "test:full-access": "ts-node tests/smoke_full_access.ts",
    "test:scheduler": "ts-node tests/smoke_scheduler.ts",
    "test:settings": "ts-node tests/smoke_settings.ts",
    "test:no-console": "python tests/test_no_console.py",
    "test:apps": "python tests/test_app_resolver.py",
    "test:policy": "python tests/test_command_policy.py",
    "test:capabilities": "ts-node tests/smoke_capabilities.ts",
    "test:delivery": "ts-node tests/smoke_delivery.ts",
    "test:stop": "ts-node tests/smoke_stop.ts",
    "test:shell-gate": "ts-node tests/smoke_shell_gate.ts",
    "app": "cd app && flutter run --release -d windows",
    "app:debug": "cd app && flutter run -d windows",
    "test:step-refs": "ts-node tests/smoke_step_refs.ts",
    "test:handoff": "ts-node tests/smoke_handoff.ts",
    "test:repair": "ts-node tests/smoke_repair.ts",
    "test:autosave": "ts-node tests/smoke_autosave.ts",
    "test:backlight": "python tests/test_backlight.py",
    "test:trace": "python tests/test_image_trace.py",
    "test:canvas": "ts-node tests/smoke_canvas.ts",
    "test:routes": "ts-node tests/smoke_site_routes.ts",
    "test:site-creds": "python tests/test_site_credentials.py",
    "test:exit-codes": "ts-node tests/test_exit_codes.ts",
    "test:liveness": "ts-node tests/test_liveness.ts",
    "test:index": "python tests/test_index.py",
    "test:artifacts": "ts-node tests/smoke_artifacts.ts",
    "test:conversations": "ts-node tests/smoke_conversations.ts",
    "test:reminders": "ts-node tests/smoke_reminders.ts",
    "test:connectors": "ts-node tests/smoke_connectors.ts",
    "test:browser-tools": "ts-node tests/smoke_browser_tools.ts",
    "test:bridge": "python tests/test_bridge.py",
    "test:owner-primitives": "python tests/test_owner_primitives.py",
    "test:browser-session": "python tests/test_browser_session.py",
    "test:kill-tree": "ts-node tests/smoke_kill_tree.ts",
    "test:profile": "python tests/test_profile_persistence.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.45.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
